root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
max_line_length = 100
trim_trailing_whitespace = true
insert_final_newline = true

[*.{js,ts,jsx,tsx}]
indent_size = 2
max_line_length = 100

[*.{html,css,scss,less}]
indent_size = 2
max_line_length = 100

[*.json]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off
