{
  "name": "async-race-team",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint:styles": "stylelint '**/*.{css,scss,less}'",
    "lint:styles:fix": "stylelint '**/*.{css,scss,less}' --fix",
    "lint:ts": "eslint --ext .ts",
    "lint:ts:fix": "eslint --ext .ts . --fix",
    "lint": "npm run lint:styles && npm run lint:ts",
    "lint:fix": "npm run lint:styles:fix && npm run lint:ts:fix",
    "format": "prettier '**/*.{js,jsx,ts,tsx}' --write",
    "prepare": "husky init",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.3.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "prettier": "^3.7.4",
    "stylelint": "^16.26.1",
    "stylelint-config-clean-order": "^8.0.0",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.52.0",
    "validate-branch-name": "^1.3.2",
    "vite": "^7.2.4"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": "eslint --fix",
    "src/**/*.css": "stylelint --fix"
  },
  "validate-branch-name": {
    "pattern": "^(feature|fix)\\/([a-z0-9-]+)$",
    "errorMsg": "Invalid branch name format"
  }
}
